  },
  {
   "id": "xiangzhuan",
   "label": "『주역』 상전(대상전)",
   "detail": "각 괘의 ‘象曰’ 구절 가운데 괘 전체의 상을 풀이한 대상(大象). 공유 저작물입니다.",
   "url": "https://ctext.org/book-of-changes/zh"
  },
  {
   "id": "xuguazhuan",
   "label": "『주역』 서괘전",
   "detail": "64괘가 이어지는 차례를 설명한 역전(易傳). 공유 저작물입니다.",
   "url": "https://ctext.org/book-of-changes/xu-gua/zh"
  },
  {
   "id": "shuoguazhuan",
   "label": "『주역』 설괘전",
   "detail": "8괘의 자연 상징과 성질, 방위 배열의 근거가 되는 역전. 공유 저작물입니다.",
   "url": "https://ctext.org/book-of-changes/shuo-gua/zh"
  },
  {
   "id": "daxue",
   "label": "『예기』 대학",
   "detail": "수신·제가·치국·평천하라는 단계 표현의 출처. 공유 저작물입니다.",
   "url": "https://ctext.org/liji/da-xue/zh"
  },
  {
   "id": "editorial",
   "label": "주역의 원 편집부 번역·풀이",
   "detail": "한국어 독음·번역·쉬운 풀이·질문·이야기 연결은 이 앱을 위해 새로 작성한 글입니다. 생성 도구의 도움을 받은 초안이며, 공개 출시 전에 원문 대조와 한국어 교열을 거쳐야 합니다."
  }
